# ---------------------------------------------------------------------------
# Airopa GCC Scoring Engine — environment configuration
# Copy this file to `.env` and fill in values. `.env` is git-ignored.
# The engine runs fully without an API key; the LLM-backed tasks
# (narrative generation, ambiguous-title classification) simply fall back
# to deterministic behaviour when the key is absent.
# ---------------------------------------------------------------------------

# --- AI model (optional) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Cheap model: title-classification fallback, extraction.
LLM_MODEL_SMALL=claude-haiku-5-5
# Strong model: Tier-3 narrative, scope/peer reasoning.
LLM_MODEL_LARGE=claude-sonnet-5-5

# --- Apollo (optional) -----------------------------------------------------
# India headcount + India titles (free people search). Set APOLLO_PAID_CALLS
# to true to also fetch revenue/headcount (enrich) and India job postings:
# 1 credit each per company. Responses are cached per domain for APOLLO_CACHE_DAYS.
APOLLO_API_KEY=
APOLLO_PAID_CALLS=false
APOLLO_CACHE_DAYS=30

# --- Storage ---------------------------------------------------------------
# SQLite by default. Swap for a Postgres URL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/airopa
DATABASE_URL=sqlite:///./data/airopa.db

# --- Internal surface auth -------------------------------------------------
# A simple shared token required on /api/assess. Leave blank to disable
# (local dev only — always set this in production).
INTERNAL_API_TOKEN=

# --- Config version --------------------------------------------------------
# Stamped onto every run so historical scores can be reproduced exactly.
CONFIG_VERSION=v3.0-build1

# --- Target geography (X14) — ISO-ish labels, comma separated --------------
TARGET_GEOGRAPHY=NL,BE,DE,UK,Nordics,FR

# ---------------------------------------------------------------------------
# TUNE thresholds — v1 defaults from the spec. Calibrate against the
# back-test set before volume running. Never hard-code these in logic.
# ---------------------------------------------------------------------------
# India gate (Section 3.2)
GATE_TECH_ROLE_COUNT_MIN=5            # GATE.06 >= 5
GATE_TECH_ROLE_SHARE_MIN=0.20         # GATE.07 >= 0.20
GATE_TECH_ROLE_SHARE_HEADCOUNT_MIN=10 # paired with share rule (GATE.04 >= 10)
GATE_MIN_EVIDENCE_RECORDS=10          # GATE.12 < 10 -> CAUTION
GATE_IT_SUPPORT_ESCALATE=15           # IT-support headcount > 15 -> CAUTION
GATE_AMBIGUOUS_SHARE_CAUTION=0.40     # ambiguous titles > 40% -> CAUTION
GATE_AMBIGUOUS_MIN_TITLES=10          # ...but only with at least this many titles

# Exclusions (Section 4.1)
X5_REVENUE_FLOOR_EUR=200000000        # below -> DISQUALIFY
X6_REVENUE_CEILING_EUR=5000000000     # above -> FLAG
X7_HEADCOUNT_FLOOR=500                # below -> DISQUALIFY
X16_MIN_COMPANY_AGE_YEARS=5           # younger -> DISQUALIFY
X20_COVERAGE_FLOOR=0.40               # below after Tier 2 -> CAUTION

# Tier routing (Section 2)
TIER3_PROVISIONAL_SCORE_MIN=55        # internal records below this skip Tier 3

# Publication safety (Section 9.6)
PUBLICATION_SCORE_COVERAGE_FLOOR=0.55 # below -> score hidden on public page
PUBLICATION_OVERALL_COVERAGE_FLOOR=0.40 # below -> INSUFFICIENT_DATA mode
PUBLICATION_CLAIM_CONFIDENCE_FLOOR=0.50 # per-claim confidence floor
